{
  "id": "/quran-mobile/",
  "name": "Quran Reader & Multilingual Tafsir",
  "short_name": "Quran Mobile",
  "description": "Mobile Quran App with Multilingual Tafsirs (EN, AR, UR, RU, BN), Audio & Offline Support",
  "start_url": "/quran-mobile/",
  "scope": "/quran-mobile/",
  "display": "standalone",
  "background_color": "#0f172a",
